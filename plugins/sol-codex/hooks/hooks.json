{
  "description": "SoL-inspired local efficiency and verification hooks for Codex Desktop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 5,
            "statusMessage": "Loading efficient-loop state",
            "additionalContextLimit": 1200,
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 10,
            "statusMessage": "Recording verifier status",
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 10,
            "statusMessage": "Preserving verification evidence",
            "additionalContextLimit": 1800,
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 5,
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 5,
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking verification debt",
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/sol_hook.py\"",
            "timeout": 3,
            "commandWindows": "C:/Python311/python.exe -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','sol_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
